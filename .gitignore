# ============================================================
# 仓库只收「源码 / 文档 / 配置模板」，其余一律排除。
# 口径与 .dockerignore 对齐（见该文件顶部说明），差异见下方注释。
# 排除原则：可再生成（依赖、构建产物）、运行时数据、本地实验残留、含密钥的文件。
# ============================================================

# ---------- 密钥（最高优先级，任何情况下不得入库存到公开仓库） ----------
.env
.env.*
!.env.example
!.env.prod.example
*.pem
*.key
secrets/
credentials.json

# ---------- Python 环境与缓存 ----------
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 前端依赖与产物 ----------
**/node_modules/
web/dist/
web/dist_gone_*/
web/.vite/
web/test-results/
web/playwright-report/
web/reg_sidebar.json
web/registry_tmp.json

# ---------- 运行时数据（本地跑出来的，镜像与仓库都不收） ----------
data/
*.db
*.db-journal
*.sqlite
*.sqlite3
milvus_lite/
milvus_lite.db
uploads/

# ---------- 第三方参考资料（各自是独立 git 克隆，纳入会变嵌套仓库） ----------
references/

# ---------- 本地实验残留与日志 ----------
tmp_*/
tmp*
*.log
*.xml
!pom.xml

# ---------- 截图与设计稿（本地存档） ----------
shots/
ui-*.png
# 但 README「二、界面预览」正文引用的这 8 张必须入库：
# `ui-*.png` 不含斜杠，按 gitignore 规则匹配任意层级，会把 docs/images/ 里
# 的正式截图一并吃掉——本地看得见、GitHub 上是 8 个裂图。
!docs/images/ui-*.png

# ---------- 编辑器 / IDE / 系统 ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------- 工作记忆与 Agent 运行时目录 ----------
.workbuddy/

# ---------- D64-D69 新增排除 ----------
# 本地 scratch（单下划线前缀 = 临时实验）
_ab_*.py
_cmp_*.py
_check_*.py
_find_*.py
_map_*.py
_probe_ports.py
_prove_*.py
_repro_*.py
_run_build.py
_scan_asar*.py
_seed_demo_assets.py
_swap_icons.py
_verify_*.py
_ports.txt
scripts/_gen_arch_pptx.py
scripts/build_readme_preview.py
# A/B 测试中间产物
web/_ab_*.json
web/_oxlint_icons.txt
web/_tsc_icons.txt
web/_vt_*.txt
web/public/_logo_backup_*/
# demo seed 输出
demo_ws/
# 临时测试输出
_tmp_*.txt
