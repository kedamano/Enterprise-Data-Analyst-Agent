# ============================================================
# Secret 敏感配置模板
# ============================================================
# ⚠️  所有值为占位符 CHANGEME_BASE64，部署前请替换为真实 Base64 值。
#
# 安全方案（二选一）：
#   1) Sealed Secrets（Bitnami）
#      - 集群侧安装 controller 后，本地用 kubeseal 加密（只能集群公钥解密）
#      - 用法：
#          kubeseal --format=yaml < secret.yaml.template > sealed-secret.yaml
#          kubectl apply -f sealed-secret.yaml
#   2) External Secrets Operator (ESO) + AWS Secrets Manager / Vault
#      - 通过 ClusterExternalSecret / ExternalSecret 从外部源同步
#
# ⚠️  禁止将明文 Secret 提交到 Git！
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: edaa-secrets
  namespace: edaa
  labels:
    app: edaa
type: Opaque
data:
  # openssl rand -base64 48
  SECRET_KEY: CHANGEME_BASE64

  # URL 编码密码示例: postgresql://edaa_user:<password>@postgres:5432/edaa
  # python -c "import urllib.parse; print(urllib.parse.quote('YOUR_PASSWORD', safe=''))"
  POSTGRES_PASSWORD: CHANGEME_BASE64

  # 拼接方式: redis://[:password@]redis:6379/0
  REDIS_URL: CHANGEME_BASE64

  # OIDC Client Secret（如使用 Auth0 / Keycloak）
  OIDC_CLIENT_SECRET: CHANGEME_BASE64

  # LLM API Key（如走后端代理而非直连）
  LLM_API_KEY: CHANGEME_BASE64
