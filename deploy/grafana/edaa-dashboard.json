{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "EDAA Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "graph",
      "name": "Graph",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "EDAA Enterprise Data Analyst Agent — 核心运行指标看板",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "SLO 概览",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "SLO #1 可用性 (目标 ≥99%)",
      "type": "stat",
      "targets": [
        {
          "expr": "1 - (rate(http_requests_total{status=~\"5..\"}[1h]) / rate(http_requests_total[1h]))",
          "legendFormat": "availability"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 8 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "SLO #2 P95 延迟 (目标 ≤5s)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.90 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "SLO #3 工具可靠性 (目标 ≥95%)",
      "type": "stat",
      "targets": [
        {
          "expr": "1 - (rate(tool_calls_failed_total[1h]) / rate(tool_calls_total[1h]))",
          "legendFormat": "tool reliability"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "SLO #4 降级率 (目标 ≤1%)",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(llm_fallbacks_total[1h]) / rate(llm_calls_total[1h])",
          "legendFormat": "degradation rate"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.10 },
              { "color": "red", "value": 0.20 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "SLO #5 数值可信度 (目标 ≤5%)",
      "type": "stat",
      "targets": [
        {
          "expr": "trace_hallucination_ratio",
          "legendFormat": "hallucination ratio"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100000 },
              { "color": "red", "value": 2000000 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "SLO #6 活跃会话数",
      "type": "stat",
      "targets": [
        {
          "expr": "active_sessions",
          "legendFormat": "active sessions"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "panels": [],
      "title": "面板 A：请求量 + 时延趋势",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "pointSize": 3 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "HTTP 请求速率 (按 status)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(http_requests_total{status=~\"2..\"}[5m])", "legendFormat": "2xx" },
        { "expr": "rate(http_requests_total{status=~\"4..\"}[5m])", "legendFormat": "4xx" },
        { "expr": "rate(http_requests_total{status=~\"5..\"}[5m])", "legendFormat": "5xx" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "HTTP 延迟分位 (P50/P95/P99)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "panels": [],
      "title": "面板 B：工具调用量 / 失败率",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "id": 20,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "工具调用 (成功 vs 失败)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(tool_calls_total[5m]) - rate(tool_calls_failed_total[5m])", "legendFormat": "success" },
        { "expr": "rate(tool_calls_failed_total[5m])", "legendFormat": "failed" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 },
      "id": 21,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" } },
      "title": "工具失败率 (5m 滑动)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(tool_calls_failed_total[5m]) / rate(tool_calls_total[5m])",
          "legendFormat": "failure rate"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 103,
      "panels": [],
      "title": "面板 C：LLM Token 与成本",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "tok/s"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 23 },
      "id": 30,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "list", "placement": "bottom" } },
      "title": "LLM Token 吞吐",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(llm_prompt_tokens_total[5m])", "legendFormat": "prompt tok/s" },
        { "expr": "rate(llm_completion_tokens_total[5m])", "legendFormat": "completion tok/s" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "USD/h"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 23 },
      "id": 31,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" } },
      "title": "LLM 估算成本 ($/h)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(llm_cost_usd_total[1h]) * 3600", "legendFormat": "$/h" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "cps"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 23 },
      "id": 32,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" } },
      "title": "LLM 降级与回退",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(llm_calls_total[5m])", "legendFormat": "calls/s" },
        { "expr": "rate(llm_fallbacks_total[5m])", "legendFormat": "fallbacks/s" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 104,
      "panels": [],
      "title": "面板 D：安全事件 + 缓存 + DB 池",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 31 },
      "id": 40,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" } },
      "title": "安全事件 (401/429/503)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(event_http_401_total[5m])", "legendFormat": "401 unauthorized" },
        { "expr": "rate(event_http_429_total[5m])", "legendFormat": "429 rate limited" },
        { "expr": "rate(event_http_503_total[5m])", "legendFormat": "503 service unavailable" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 31 },
      "id": 41,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "list", "placement": "bottom" } },
      "title": "缓存命中率",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(cache_hits_total[5m]) / (rate(cache_hits_total[5m]) + rate(cache_misses_total[5m]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 31 },
      "id": 42,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" } },
      "title": "DB 连接池状态",
      "type": "timeseries",
      "targets": [
        { "expr": "db_pool_size", "legendFormat": "pool size" },
        { "expr": "db_pool_connections", "legendFormat": "active conns" },
        { "expr": "db_pool_waiters", "legendFormat": "waiters" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "id": 105,
      "panels": [],
      "title": "面板 E：导出与溯源",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 39 },
      "id": 50,
      "options": { "legend": { "calcs": ["mean", "p95"], "displayMode": "list", "placement": "bottom" } },
      "title": "导出耗时 (P50/P95)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(export_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(export_duration_seconds_bucket[5m]))", "legendFormat": "p95" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "Bps"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 39 },
      "id": 51,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "list", "placement": "bottom" } },
      "title": "导出吞吐 (bytes/s)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(export_bytes_total[5m])", "legendFormat": "bytes/s" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 39 },
      "id": 52,
      "options": { "legend": { "calcs": ["mean", "sum"], "displayMode": "list", "placement": "bottom" } },
      "title": "数值溯源与幻觉率",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(trace_numeric_claims_total[5m])", "legendFormat": "numeric claims/s" },
        { "expr": "rate(trace_untraced_claims_total[5m])", "legendFormat": "untraced/s" },
        { "expr": "trace_hallucination_ratio", "legendFormat": "hallucination ratio" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["edaa", "llm", "data-analyst"],
  "templating": {
    "list": []
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "EDAA · SLO & Operations Dashboard",
  "uid": "edaa-slo-dashboard",
  "version": 1,
  "weekStart": ""
}
