# 统一换行符：仓库内一律存 LF，检出时按平台自动转换。
# 不加这个文件时，Windows(core.autocrlf=true) 会让每次改动都显示「整文件变更」。
* text=auto

# 文本文件强制 LF
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
Dockerfile text eol=lf

# Windows 批处理保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不做转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.db   binary
*.xlsx binary
*.docx binary
