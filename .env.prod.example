# ===== Data Analyst Agent 生产环境变量示例 =====
# 复制为 .env 后按需修改。所有中间件都可省略（自动降级），最小可用只需 LLM。

# ---- LLM（OpenAI 兼容，OpenRouter/DeepSeek/vLLM 均可）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
# 真实上线建议开启：LLM 失败直接报错，绝不静默降级成 Mock 返回假分析
LLM_NO_FALLBACK=true
MOCK_LLM=false

# 多供应商路由（可选，留空则单模型）：
# LLM_ROUTES=[{"model":"deepseek-chat","base_url":"https://api.deepseek.com/v1","api_key":"sk-x","priority":0,"weight":3}]

# 成本计费（USD/百万token，用于 eval 成本实算，可留 0）
COST_INPUT_PER_MTOK=0.27
COST_OUTPUT_PER_MTOK=1.10

# ---- 数据源（Agent 分析的真实业务库，支持 sqlite/postgresql/mysql）----
DATA_DB_URL=sqlite:///./data/sample_enterprise.db
DATA_DB_DIALECT=sqlite

# ---- 安全（默认已收紧）----
PYTHON_SANDBOX_ENABLED=true
PYTHON_SANDBOX_MODE=subprocess   # 容器内推荐 subprocess；docker 模式需把 docker.sock 给容器（慎用）
PYTHON_MAX_EXEC_S=30
SQL_MAX_ROWS=5000

# ---- 可选中间件（不配则自动降级为 SQLite/内存/JSONL）----
# REDIS_URL=redis://redis:6379/0
# 跨机房/跨可用区部署时上调这两个超时（默认 0.2/0.5 秒，见 DEGRADE/02）
# REDIS_CONNECT_TIMEOUT_S=2
# REDIS_SOCKET_TIMEOUT_S=5
# POSTGRES_DSN=postgresql+psycopg2://da:da@pg:5432/da_agent
# MILVUS_HOST=milvus

# ---- 多租户（默认单租户/全局）----
# DEFAULT_TENANT=

# ---- 可观测（默认落 data/traces、data/audit）----
# CHECKPOINT_DIR=data/checkpoints
