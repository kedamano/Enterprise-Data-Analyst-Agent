# ---- App ----
APP_NAME=Enterprise Data Analyst Agent
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ---- LLM gateway (OpenAI-compatible) ----
# 任意兼容端点均可：OpenAI / DeepSeek / Mistral / vLLM / 本地 llama.cpp
# ⚠️ 这里是模板文件，不要填真实 Key。复制成 .env 后再填，.env 已被 .gitignore 排除。
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=120
# 无 API Key 或 MOCK_LLM=1 时启用离线 Mock，管道仍可端到端运行
MOCK_LLM=false

# ---- Enterprise analytical data source (Agent 查询的目标库) ----
DATA_DB_URL=sqlite:///./data/sample_enterprise.db
DATA_DB_DIALECT=sqlite

# ---- Knowledge base (RAG) ----
KNOWLEDGE_ENABLED=true
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_COLLECTION=da_knowledge
EMBED_MODEL=all-MiniLM-L6-v2
RERANK_ENABLED=false

# ---- Memory / cache ----
# E4/02 输出脱敏（**默认开**）：敏感列的值不进 LLM 上下文；CSV 产物不脱敏。
# MASK_LEVEL：sample（掩值，默认）| strict（敏感列不出现在上下文）| none（关闭，会审计留痕）
MASK_PII_ENABLED=true
MASK_LEVEL=sample
# 列名未命中内置模式表、但需要额外脱敏的列（逗号分隔）
MASK_PII_COLUMNS=

REDIS_URL=
# 中间件「配了但没起」时快速失败（DEGRADE/02）：连接/读写超时（秒）。
# 留空/不配即用默认 0.2 / 0.5；跨机房部署请上调（如 2 / 5）。
REDIS_CONNECT_TIMEOUT_S=0.2
REDIS_SOCKET_TIMEOUT_S=0.5
# 短期记忆（Redis `da:st:<session>` hash）的滑动过期（秒），默认 86400（24h）。
# 不设过期会让会话键在 Redis 里只增不减；配 0 = 不过期（仅本地调试）。
SHORT_TERM_TTL_S=86400
POSTGRES_DSN=

# ---- Safety ----
SQL_MAX_ROWS=5000
SQL_READONLY=true
PYTHON_SANDBOX_ENABLED=true
PYTHON_MAX_EXEC_S=30

# ---- Orchestration ----
MAX_REPLANS=2
MAX_PLAN_STEPS=8

# --- AUTH/01 用户级鉴权与数据权限（默认关；生产务必打开）---
AUTH_ENABLED=false
# JSON 数组：[{key, user_id, tenant, allowed_tables?, denied_columns?, row_filters?, quota_per_min?}]
# 例：AUTH_KEYS=[{"key":"k-alice","user_id":"alice","tenant":"acme",
#                 "allowed_tables":["fact_sales","dim_region"],
#                 "denied_columns":["customers"],
#                 "row_filters":{"fact_sales":"region_id IN (1,2)"},
#                 "quota_per_min":30}]
AUTH_KEYS=
