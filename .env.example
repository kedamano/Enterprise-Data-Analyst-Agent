# ---- App ----
APP_NAME=Enterprise Data Analyst Agent
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ---- LLM gateway (OpenAI-compatible) ----
# 任意兼容端点均可：OpenAI / DeepSeek / Mistral / vLLM / 本地 llama.cpp
# ⚠️ 这里是模板文件，不要填真实 Key。复制成 .env 后再填，.env 已被 .gitignore 排除。
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
# 推理模型（如 glm-5.3 / o 系列）会把大量 token 花在 reasoning 上：
# 实测 glm-5.3 一次 planner 调用 731 completion tokens 里 512 是 reasoning，
# 给 2048 会把正文挤空（content 为空字符串）。用推理模型时请留足余量。
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=180
# **墙钟兜底**（秒）：与传输层 timeout 无关的硬上限。
# httpx 的 read timeout **每收到一块数据就重置**，上游周期性吐 keep-alive 时它永不触发
# —— 实测进程在 LLM 调用上挂了 >3 小时（CPU=0s），而 timeout=300 + 5 次重试没兜住。
# 必须**大于** LLM_TIMEOUT_S（实测单次 context 调用可到 253s）。设 0 = 关闭兜底。
LLM_HARD_DEADLINE_S=600

# ---- prompt 预算（D42） ----
# 按 CJK 感知的字符代理估算 token，超限时按优先级压缩 task_context：
# 先砍工具结果的行数据 → 再丢最旧的工具结果 → 最后只留 context/plan。
# **压缩说明会写进 prompt 的 <context_budget> 块**（不许静默截断）。
# 实测正常单次 prompt 约 5–9k tokens，16000 只兜异常大的尾巴。设 0 = 关闭。
PROMPT_BUDGET_TOKENS=16000

# ---- 单会话（按 run）token 熔断（D43） ----
# 累计 token 超此值即**拒绝发起新的 LLM 调用**（不是事后报警）。
# 默认 200 万：明显高于一次正常全量（实测 ≈91 万），给重规划留余量又能兜住打滑。
# **默认值不能打断正常跑**。设 0 = 关闭。
SESSION_TOKEN_BUDGET=2000000

# ---- 日志采样（D44） ----
# 1.0 = 不采样。高并发下每个节点一条 [span] INFO，量级随请求线性上涨。
# **只采「正常」，失败永不采样**（采掉失败日志 = 故障自愈）。
# 写 0/负数 = 不采样（不是全丢弃：静音日志不是采样，是失明）。
LOG_SAMPLE_RATIO=1.0

# ---- eval 成本折算（USD / 每百万 token） ----
# **未设置** = 单价未知 → eval 报告 cost=None，渲染为"未计（未配单价）"
# **显式设 0** = 已知免费 → eval 报告 0.0，渲染为"0.0（单价为 0 = 已知免费）"
# 两者语义不同、必须可区分。跑 `-free` 档模型时请显式写 0，否则成本列恒为"未计"。
# 代码**不猜单价**（硬编码一个数是编数据）：填上真实单价后成本列才有意义。
# COST_INPUT_PER_MTOK=0
# COST_OUTPUT_PER_MTOK=0
# 无 API Key 或 MOCK_LLM=1 时启用离线 Mock，管道仍可端到端运行
MOCK_LLM=false

# ---- Prompt 注入防御 ----
# 双层防御：结构清洗 + 注入检测。默认开启（fail-open：guard 异常绝不影响主分析）。
# 动作：passthrough = 仅标记不脱敏；redact = 命中并替换 [REDACTED]（默认）；block = 高置信阻断。
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_ACTION=redact
PROMPT_GUARD_LOG_LEVEL=WARNING

# ---- LangFuse 远程可观测（opt-in：不配 SECRET/PUBLIC KEY = 纯本地 trace JSONL） ----
# 配对后，每个分析阶段 span 双写到 LangFuse 云端 → 云端 trace view / 告警 / 成本归因。
# 本地 JSONL trace 永不依赖 LangFuse，断网/缺包时自动回落。
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Stage-Aware Tiered LLM Routing ----
# 移除 tier= 字段 = 向后兼容（legacy 路径）；添加即启用分级路由
# 按分析阶段（context/planner/executor/analyst/reflection/reporter）的复杂度自动选模型档位：
#   "light" = 快且便宜（Haiku / DeepSeek / Flash），用于 context/planner/executor/reflection
#   "heavy" = 强模型（Sonnet / GPT-4o），用于 analyst/reporter
# 未带 tier 的 route 归入 legacy 池（向后兼容，行为不变）。
# LLM_ROUTES='[
#   {"model":"deepseek-chat","base_url":"https://api.deepseek.com","api_key":"sk-xxx","priority":0,"weight":1,"tier":"light"},
#   {"model":"claude-sonnet-4-20250514","base_url":"https://api.anthropic.com","api_key":"sk-xxx","priority":0,"weight":1,"tier":"heavy"},
#   {"model":"gpt-4o","base_url":"https://api.openai.com/v1","api_key":"sk-xxx","priority":1,"weight":1,"tier":"heavy"}
# ]'

# ---- Enterprise analytical data source (Agent 查询的目标库) ----
DATA_DB_URL=sqlite:///./data/sample_enterprise.db
DATA_DB_DIALECT=sqlite

# ---- Knowledge base (RAG) ----
KNOWLEDGE_ENABLED=true
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_COLLECTION=da_knowledge
EMBED_MODEL=all-MiniLM-L6-v2
RERANK_ENABLED=false
# RAG-01：检索低置信阈值（首条短语亲和分低于此值即判低置信 → **内容不下发给模型**）。
# 0.15 是黄金集量出来的（6 正例 0.188~0.500 / 负例 0.111）；改动前先看
# docs/specs/RAG/01-low-confidence-fallback.md §2.1.1，并重跑 tests/test_rag_confidence.py
# 的两条标定用例。非法值退回默认，不会让检索整体不可用。
RAG_MIN_CONFIDENCE=0.15

# ---- Semantic cache ----
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# ---- Memory / cache ----
# E4/02 输出脱敏（**默认开**）：敏感列的值不进 LLM 上下文；CSV 产物不脱敏。
# MASK_LEVEL：sample（掩值，默认）| strict（敏感列不出现在上下文）| none（关闭，会审计留痕）
MASK_PII_ENABLED=true
MASK_LEVEL=sample
# 列名未命中内置模式表、但需要额外脱敏的列（逗号分隔）
MASK_PII_COLUMNS=

# ---- Docker Compose 中间件凭据 ----
# docker-compose.yml 中 postgres / minio 通过 ${VAR:-default} 引用本文件；
# 生产务必覆盖默认值，不要直用 minioadmin/minioadmin / da/da。
POSTGRES_USER=da
POSTGRES_PASSWORD=da
POSTGRES_DB=da_agent
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

REDIS_URL=
# 中间件「配了但没起」时快速失败（DEGRADE/02）：连接/读写超时（秒）。
# 留空/不配即用默认 0.2 / 0.5；跨机房部署请上调（如 2 / 5）。
REDIS_CONNECT_TIMEOUT_S=0.2
REDIS_SOCKET_TIMEOUT_S=0.5
# 短期记忆（Redis `da:st:<session>` hash）的滑动过期（秒），默认 86400（24h）。
# 不设过期会让会话键在 Redis 里只增不减；配 0 = 不过期（仅本地调试）。
SHORT_TERM_TTL_S=86400
POSTGRES_DSN=

# ---- Safety ----
SQL_MAX_ROWS=5000
SQL_READONLY=true
PYTHON_SANDBOX_ENABLED=true
PYTHON_MAX_EXEC_S=30

# ---- Orchestration ----
MAX_REPLANS=2
MAX_PLAN_STEPS=8
SUPERVISOR_ENABLED=true

# ---- Workflow Jobs（定时 / 一次性调度） ----
# 启用后用户可创建定时任务；分析结果按 schedule 自动跑 + 回调 webhook。
WORKFLOW_JOBS_ENABLED=true
WORKFLOW_JOBS_MAX_PER_USER=10
MAX_SUBTASKS=4

# --- Self-Consistency / 多次采样投票 ---
SELF_CONSISTENCY_ENABLED=true
SELF_CONSISTENCY_N=3
SELF_CONSISTENCY_TEMPERATURE=0.7
SELF_CONSENSUS_THRESHOLD=0.6

# --- AUTH/01 用户级鉴权与数据权限（默认关；生产务必打开）---
AUTH_ENABLED=false
# JSON 数组：[{key, user_id, tenant, allowed_tables?, denied_columns?, row_filters?, quota_per_min?}]
# 例：AUTH_KEYS=[{"key":"k-alice","user_id":"alice","tenant":"acme",
#                 "allowed_tables":["fact_sales","dim_region"],
#                 "denied_columns":["customers"],
#                 "row_filters":{"fact_sales":"region_id IN (1,2)"},
#                 "quota_per_min":30}]
AUTH_KEYS=

# --- D45 两步授权（HITL）：高危动作需二次确认，**默认关** ---
# 打开后 export_raw（导出未脱敏原始值）/ deliver_python（交付模型写的脚本）
# 以及**任何未登记的动作**都需人工确认（POST /chat/analyze/confirm）。
# 策略是「默认拒绝 + 显式放行」；低危动作请在 hitl._SAFE 登记。
# 允许与拒绝**都写审计**（只记拒绝无法复盘）。
HITL_ENABLED=false
HITL_AUDIT_LOG=data/audit/hitl.jsonl

# --- 多级 LLM 用量预算 ---
BUDGET_ENABLED=true
# 单会话 token 上限（每次 run 的 prompt+completion token 总和）
BUDGET_PER_SESSION_TOKENS=50000
# 单用户日累计 token 上限
BUDGET_PER_USER_DAILY_TOKENS=200000
# 单租户月累计 token 上限
BUDGET_PER_TENANT_MONTHLY_TOKENS=10000000
# 超限策略：deny（直接拒绝）| degrade（降级到便宜模型）| queue（MVP 走 degrade 兜底）
BUDGET_OVERRUN_POLICY=degrade
# 降级模型名（BUDGET_OVERRUN_POLICY=degrade 时生效；空 = 不降级）
# BUDGET_DEGRADED_MODEL=gpt-3.5-turbo

# --- 多轮上下文窗口治理 ---
# **默认开**：长对话场景下自动压缩旧 tool_result / 旧 report 为摘要，防 token 溢出。
# 关闭时 run_cycle 不做任何上下文压缩（messages 持续累增，退回旧行为）。
CONTEXT_COMPRESSION_ENABLED=true
# 目标上下文上限（工程约束，非模型限制）。总 token 估算超过 compress_threshold × 此值时触发压缩。
CONTEXT_MAX_TOKENS=60000
# 触发压缩的阈值比例。0.8 = tokens 达到 max_tokens 的 80% 时开始压缩。
CONTEXT_COMPRESS_THRESHOLD=0.8
# 硬上限：压缩后仍超此值 → status="CONTEXT_OVERFLOW" → 前端提示"请精简问题 / 新开对话"。
CONTEXT_HARD_MAX_TOKENS=80000
# 压缩后单个 tool_result 的最大字符数。
CONTEXT_COMPRESS_TOOL_RESULT_CHARS=500
# 历史 report 压缩为 executive_summary 的最大字符数。
CONTEXT_COMPRESS_REPORT_CHARS=300

# --- D46 审计落库（SQLite / PostgreSQL）---
# jsonl（默认，既有四个文件与内容一字不变）| sqlite | postgres
# 缺口："审计为文件非不可篡改库、无 SQL 审计查询"。切到 DB 后：
#   GET /api/v1/debug/audit?kind=tool&session_id=...&since=...&limit=200
# 历史数据迁入：audit_store.import_jsonl("tool"|"auth"|"masking"|"hitl")（内容指纹保证幂等）
# **不做双写**（写两处会带来"以哪份为准"的新问题）。
AUDIT_BACKEND=jsonl
# 留空时：sqlite → ./data/audit.db；postgres → 复用 POSTGRES_DSN
AUDIT_DB_URL=

# --- AUTH/03 OIDC 登录（env-gated / fail-open；缺 OIDC_ISSUER = 整条链路静默不启用） ---
# 企业 IdP 的 issuer URL（如 https://login.microsoftonline.com/{tenant}/v2.0）
# OIDC_ISSUER=https://accounts.google.com
# 在 IdP 注册本应用拿到的 client id / secret
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# 回调地址（必须与 IdP 注册的一致；默认 https://localhost:8000/api/v1/auth/oidc/callback）
# OIDC_REDIRECT_URI=https://localhost:8000/api/v1/auth/oidc/callback
# signed cookie 密钥（生产请显式配，否则重启后 state 失效）
# OIDC_COOKIE_SECRET=
# 授权 scope（空格分隔）；加 offline_access 让 IdP 返回 refresh_token
# OIDC_SCOPE=openid email profile offline_access
# 校验 id_token 允许的签名算法（逗号分隔，默认 RS256,ES256）
# OIDC_ID_TOKEN_ALGOS=RS256,ES256
# token_endpoint 的 client 认证方式：client_secret_post（默认）/ client_secret_basic
# OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post

# --- HTTPS / mTLS（env-gated） ---
# 配 SSL_CERT_FILE / SSL_KEY_FILE 即启用 HTTPS 入口（默认文件存在时会自动切）
# SSL_CERT_FILE=certs/server.crt
# SSL_KEY_FILE=certs/server.key
# SSL_CLIENT_CA=             # 配了则 uvicorn 启用 mTLS（验证客户端证书）
# SSL_HTTP_PORT=8000
# SSL_HTTPS_PORT=8443
# 本地一键生成自签证书（含 SAN localhost/127.0.0.1/::1）：python scripts/generate_certs.py
